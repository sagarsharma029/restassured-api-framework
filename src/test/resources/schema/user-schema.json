{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "email", "username", "name"],
  "properties": {
    "id": { "type": "number" },
    "email": { "type": "string" },
    "username": { "type": "string" },
    "name": {
      "type": "object",
      "required": ["firstname", "lastname"],
      "properties": {
        "firstname": { "type": "string" },
        "lastname": { "type": "string" }
      }
    }
  }
}